# Copy this file to .env and fill in your own MongoDB Atlas connection string.
# See README.md "MongoDB Atlas setup" for how to get one.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=femina_pulse

# Change this to a long random string before deploying anywhere real.
JWT_SECRET=femina-pulse-dev-secret-change-me
